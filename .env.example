# A3 Mercados — MarketData API credentials (TEMPLATE — no real keys here)
#
# Copy this file to `.env` (which is gitignored) and paste the real keys there.
# The code reads these from the environment; keys are never hard-coded or
# committed. Prefer the UAT key for development.
#
# Docs: https://marketdata.mae.com.ar/documentacionAPI

A3_MARKETDATA_API_KEY_UAT=
A3_MARKETDATA_API_KEY_PROD=
A3_MARKETDATA_ENV=UAT

# BYMA Market Data OAuth application. Copy only this block into an existing .env.
BYMA_CLIENT_ID=
BYMA_CLIENT_SECRET=
# Use the exact method scopes shown in the BYMA developer portal.
BYMA_EOD_SCOPE=
BYMA_DELAY20_SCOPE=
